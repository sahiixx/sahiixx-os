{
  "name": "sahiixx-os",
  "version": "4.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/build-api.mjs",
    "pages:build": "bash scripts/pages-build.sh",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b --pretty false",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "echo 'no lint configured'",
    "format": "echo 'no format configured'"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/orbitron": "^5.2.5",
