{
  "name": "sahiixx-os",
  "version": "4.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/build-api.mjs",
    "pages:build": "bash scripts/pages-build.sh",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b --pretty false",
    "check:schema": "drizzle-kit export --dialect=postgresql --schema=./db/schema.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "test": "vitest run",
    "test:nexus": "vitest run --config vitest.nexus.config.ts",
    "test:charts": "vitest run --config vitest.ui.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "echo 'no lint configured'",
    "format": "echo 'no format configured'",
    "test:security": "vitest run --config vitest.security.config.ts --maxWorkers=1 --no-file-parallelism",
    "test:e2e": "playwright test",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/orbitron": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.66.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^12.0.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.474.0",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.10.1",
    "superjson": "^2.2.2",
    "tesseract.js": "^5.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@cloudflare/workers-types": "^4.2026000.0",
    "@hono/vite-dev-server": "^0.19.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "^4.1.10",
    "@playwright/test": "1.65.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.11"
    }
  }
}
