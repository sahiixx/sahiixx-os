# Copy to .env (local Vite) and/or .dev.vars (wrangler). Never commit real values.

# ── Core (required for prod) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
AUTH_SECRET=long-random-string
ADMIN_EMAIL=admin@sahiixx.os
ADMIN_PASSWORD=change-me

# ── Jarvis LLM ─────────────────────────────────────────────────────────────
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
JARVIS_PROVIDER=ollama
JARVIS_OLLAMA_MODEL=glm-5.2
OPENROUTER_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JARVIS_MODEL=openai/gpt-4o-mini

# ── Voice / social ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
POSTIZ_API_URL=
POSTIZ_API_KEY=

# ── Live bridges ───────────────────────────────────────────────────────────
ESTATE_API_URL=http://127.0.0.1:3001
ESTATE_API_KEY=
OPA_DISPATCH_URL=http://127.0.0.1:8082/dispatch
OPA_API_KEY=
# FirstCall revenue API (canonical lead -> deal -> commission) — https://sahiixx-firstcall.fly.dev
# Contracts: https://github.com/sahiixx/sahiixx-production-hardening
# Accepts the bare origin OR the full .../v1/leads URL (normalised either way),
# so a dashboard typo cannot silently 404. Blank disables the bridge: the OS
# then just skips the external push and the local write still succeeds.
FIRSTCALL_URL=https://sahiixx-firstcall.fly.dev
# Optional. The service has no auth today; set it once bearer auth is added and
# the bridge sends `Authorization: Bearer` with no code change.
FIRSTCALL_TOKEN=

# Legacy sovereign pipeline (optional). DIFFERENT service, do not point this at
# FirstCall: sovereign-revenue-os exposes /pipeline/process, FirstCall does not
# (a 404 on every push). Prefer FIRSTCALL_URL above.
REVENUE_API_URL=
REVENUE_API_KEY=
